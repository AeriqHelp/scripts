local GhostBillboard, GhostHighlight = nil, nil
function UpdateGhostEsp()
    local ghostModel = workspace:FindFirstChild("Ghost")
    if GhostEspToggle and ghostModel then
        if not GhostBillboard then
            GhostBillboard = Instance.new("BillboardGui", game:GetService("CoreGui"))
            GhostBillboard.Size = UDim2.new(0, 60, 0, 60)
            GhostBillboard.AlwaysOnTop = true
            GhostBillboard.Adornee = ghostModel
            
            local txt = Instance.new("TextLabel", GhostBillboard)
            txt.Size = UDim2.new(1, 0, 1, 0)
            txt.BackgroundTransparency = 1
            txt.Text = "Ghost"
            txt.TextColor3 = Color3.fromRGB(255, 0, 0)
            txt.TextScaled = true
            
            GhostHighlight = Instance.new("Highlight", ghostModel)
            GhostHighlight.FillColor = Color3.fromRGB(255, 0, 0)
        end
        GhostBillboard.Enabled = true
        GhostHighlight.Enabled = true
    else
        if GhostBillboard then GhostBillboard.Enabled = false end
        if GhostHighlight then GhostHighlight.Enabled = false end
    end
end

function UpdatePlrEsp()
	if PlayersEspToggle then
		for _, p in pairs(PS:GetPlayers()) do
			if p ~= plr and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
				local hrp = p.Character.HumanoidRootPart
				if not hrp:FindFirstChild("Ducko355PlrBil") then
					local Bil = Instance.new("BillboardGui", hrp)
					Bil.Name = "Ducko355PlrBil"
					Bil.Size = UDim2.new(0, 100, 0, 40)
					Bil.AlwaysOnTop = true
					local txt = Instance.new("TextLabel", Bil)
					txt.Size = UDim2.new(1, 0, 1, 0)
					txt.BackgroundTransparency = 1
					txt.Text = p.DisplayName
					txt.TextColor3 = Color3.fromRGB(0, 170, 255)
					txt.TextScaled = true
					
					local High = Instance.new("Highlight", hrp)
					High.Name = "Ducko355PlrEsp"
					High.OutlineColor = Color3.fromRGB(0, 170, 255)
					High.FillTransparency = 1
				end
			end
		end
	else
		for _, p in pairs(PS:GetPlayers()) do
			if p.Character then
				local hrp = p.Character:FindFirstChild("HumanoidRootPart")
				if hrp then
					local e1 = hrp:FindFirstChild("Ducko355PlrBil")
					local e2 = hrp:FindFirstChild("Ducko355PlrEsp")
					if e1 then e1:Destroy() end
					if e2 then e2:Destroy() end
				end
			end
		end
	end
end

local ItemEspToggle = false
function UpdateItemEsp()
    for _, v in pairs(ItemEspList) do pcall(function() v:Destroy() end) end
    ItemEspList = {}
    if ItemEspToggle then
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("Model") and v:GetAttribute("ItemName") ~= nil then
                local bGui = Instance.new("BillboardGui", v)
                local txt = Instance.new("TextLabel", bGui)
                table.insert(ItemEspList, bGui)
                bGui.Size = UDim2.new(0, 100, 0, 40)
                bGui.AlwaysOnTop = true
                txt.Size = UDim2.new(1, 0, 1, 0)
                txt.BackgroundTransparency = 1
                txt.TextColor3 = Color3.fromRGB(255, 255, 255)
                txt.Text = v:GetAttribute("ItemName")
                txt.TextScaled = true
            end
        end
    end
end

function UpdateEvidenceEsp()
	for _, v in pairs(EvidenceEspList) do pcall(function() v:Destroy() end) end
	EvidenceEspList = {}
	if EvidenceEspToggle then
		for _, obj in ipairs(workspace:GetDescendants()) do
			if obj:IsA("BasePart") and (obj.Name == "Handprint1" or obj.Name == "Handprint2" or obj.Name == "GhostOrb") then
                local bGui = Instance.new("BillboardGui", obj)
                local txt = Instance.new("TextLabel", bGui)
                table.insert(EvidenceEspList, bGui)
                bGui.Size = UDim2.new(0, 80, 0, 30)
                bGui.AlwaysOnTop = true
                txt.Size = UDim2.new(1, 0, 1, 0)
                txt.BackgroundTransparency = 1
                txt.TextColor3 = Color3.fromRGB(0, 255, 100)
                txt.Text = obj.Name
                txt.TextScaled = true
			end
		end
	end
end

