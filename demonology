                if Temp < LowestTemp then
                    LowestTemp = Temp
                    LowestTempRoom = TempRoom
                end
            end
        end
        
        local Diff = workspace:GetAttribute("Difficulty") or "Unknown"
        local PhotosCount = workspace:GetAttribute("PhotosTaken") or 0
        
        local mainOutput = string.format(
            "Difficulty: %s\n" ..
            "Photos: (%d/6)\n" ..
            "Current Room: %s\n" ..
            "Lowest Temp: %.1f°C (%s)\n\n" ..
