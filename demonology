        local GhostAge = "Unknown"
        local GhostGender = "Unknown"
        local CurrentR = "Unknown"
        
        if ghostModel then
            GhostHunting = ghostModel:GetAttribute("Hunting") or false
            GhostFavRoom = ghostModel:GetAttribute("FavoriteRoom") or "Unknown"
            GhostAge = ghostModel:GetAttribute("Age") or "Unknown"
            GhostGender = ghostModel:GetAttribute("Gender") or "Unknown"
            CurrentR = ghostModel:GetAttribute("CurrentRoom") or "Unknown"
            
